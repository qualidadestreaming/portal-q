# Portal Q — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha os valores.
# .env.local NÃO vai para o Git (está no .gitignore).
#
# Nenhuma destas variáveis tem o prefixo NEXT_PUBLIC_: elas são segredos e só
# podem ser lidas no servidor (Server Components e API Routes). Se alguma
# aparecer no bundle do navegador, é bug.

# URL do Web App do Google Apps Script. Termina sempre em /exec.
# Obtida em: Apps Script > Implantar > Nova implantação > App da Web.
PORTAL_Q_SHEETS_ENDPOINT=

# Token compartilhado entre a Vercel e o Apps Script. Precisa ser exatamente o
# mesmo valor gravado nas Propriedades do script (chave PORTAL_Q_TOKEN).
# Gere um valor aleatório longo, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_Q_SHEETS_TOKEN=
